  "family_rules": {
    "selection": {
      "payload": "content.options[] (id,text), at least 2; options also as answer_options rows",
      "answer_key": "correct_option_ids"
    },
    "matrix": {
      "payload": "content.rows[] and content.columns[] required",
      "answer_key": "rows {row_id: column_id or [ids]}"
    },
    "cloze": {
      "payload": "content.blanks[] or slots or prompt_template required",
      "answer_key": "slots {blank_id: choice_id} or accepted/text"
    },
    "sequence": {
      "payload": "content.items[] required",
      "answer_key": "order [item ids]"
    },
    "association": {
      "payload": "content.left/items and right/bins/zones required",
      "answer_key": "pairs or zones"
    },
    "interaction": {
      "payload": "content.left/items and right/bins/zones required",
      "answer_key": "pairs or zones"
    },
    "image_regions": {
      "payload": "content.regions[] with label + normalized_coordinates[4]; image_asset_id or image_url",
      "answer_key": "region_ids"
    },
    "container": {
      "payload": "no payload validation at app layer; shared_context + child_items",
      "answer_key": "children graded independently"
    },
    "constructed": {
      "payload": "content.prompt (unit optional)",
      "answer_key": "value / text / accepted"
    },
    "content": {
      "payload": "stimulus media + child items",
      "answer_key": "children"
    },
    "delivery": {
      "payload": "delivery mode only, no scorer",
      "answer_key": "none"
    },
    "performance": {
      "payload": "task + expected actions, sandbox only",
      "answer_key": "expected_actions / accepted"
    }
  },
  "markers": {
    "single_choice": "lettered options, one letter in Correct Answer, no \"which two/three\"",
    "multiple_select": "several letters in Correct Answer, or \"Which two/three\", \"Each correct answer presents\"",
    "true_false": "exactly two options True/False or Yes/No for one statement",
    "image_based_choice": "lettered options plus an exhibit image (\"shown in the following exhibit\")",
    "scenario_standalone": "shared scenario text then one or more child questions",
    "yes_no_matrix": "\"For each of the following statements, select Yes if the statement is true\", Yes/No columns",
    "single_choice_matrix": "grid with category columns, one choice per row",
    "multi_select_matrix": "grid with several choices allowed per row",
    "inline_dropdown": "\"Select the answer that correctly completes the sentence\", one drop-down in the answer area",
    "multi_blank_dropdown": "answer area with two or more drop-downs (\"Use the drop-down menus\", \"select the BEST options in the answer area\")",
    "text_cloze": "blanks to type, no choice list",
    "ordering": "\"arrange in the correct order\", \"DRAG DROP ... sequence\"",
    "matching": "two lists to pair (\"match each\")",
    "categorization": "items to sort into named bins",
    "drag_drop": "\"DRAG DROP\", tiles dragged to targets",
    "hotspot_single": "click one area of an image",
    "hotspot_multi": "click every area that applies on an image",
    "case_study_group": "\"Case study\" with several questions on shared context",
    "active_screen": "mock application screen with boxed controls to click (\"select the appropriate options in the answer area\" on a screenshot)",
    "short_text": "type a short answer",
    "numeric": "type a number",
    "multimedia_stimulus": "audio/video/media stimulus with child items",
    "sectioned_delivery": "delivery mode, not found in question files",
    "unscored_pretest": "delivery mode, not found in question files",
    "adaptive_delivery": "delivery mode, not found in question files",
    "simulation_ui": "lab simulation performed in a UI",
    "terminal_task": "type a command in a terminal",
    "lab_task": "multi-step lab",
    "code_answer": "write or complete code",
    "testlet": "short shared stem with follow-up items kept together"
  },
