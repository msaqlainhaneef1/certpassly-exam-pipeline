{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certpassly.com/reference/site-format/v2/question.schema.json",
  "title": "CertPassly site format v2 (simulator plan t527u, Phase 2)",
  "description": "Single source of truth for exam and question JSON. Fields follow docs/simulator/SIMULATOR-PLAN-T527U.md Phase 2 only. learner is shown to students; answer is server only and moves to the encrypted keys table on import. No raw HTML anywhere. Allowed link domains are enforced by the importer from config.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exam",
    "questions"
  ],
  "properties": {
    "exam": {
      "$ref": "#/$defs/exam"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "plain_text": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*<\\s*[A-Za-z!/?])[\\s\\S]*$"
    },
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/plain_text"
        },
        "marks": {
          "type": "array",
          "items": {
            "enum": [
              "bold",
              "italic",
              "code"
            ]
          }
        },
        "link": {
          "type": "string",
          "pattern": "^https://[^\\s<>]+$"
        }
      }
    },
    "rich_block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "enum": [
                "bullet_list",
                "ordered_list"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/inline"
                },
                "minItems": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "rich_text": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rich_block"
      },
      "minItems": 1
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "alt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://|/storage/)[^\\s<>]+$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*<\\s*[A-Za-z!/?])[\\s\\S]*$"
        }
      }
    },
    "content_block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "columns",
            "rows",
            "cells"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rich_text"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rich_text"
              }
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/rich_text"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "nodes"
          ],
          "properties": {
            "type": {
              "const": "diagram"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "text": {
                    "$ref": "#/$defs/plain_text"
                  }
                }
              }
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "target",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "text": {
                    "$ref": "#/$defs/plain_text"
                  }
                }
              },
              "description": "Each label has its own id and names the id of a node, connector or region in the same diagram (owner t544u, t545u). Every id in a diagram is unique; unknown targets and repeated ids are rejected at import."
            },
            "connectors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "from",
                  "to"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  }
                }
              }
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "text": {
                    "$ref": "#/$defs/plain_text"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "language",
            "code"
          ],
          "properties": {
            "type": {
              "const": "code_snippet"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z0-9+#.-]+$"
            },
            "code": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "exhibit"
            },
            "content": {
              "$ref": "#/$defs/rich_text"
            },
            "media": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/media"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "case_study"
            },
            "content": {
              "$ref": "#/$defs/rich_text"
            }
          }
        }
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "choose_n": {
          "type": "integer",
          "minimum": 1
        },
        "drag_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plain_text"
          }
        },
        "hotspot_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hotspot_region"
          }
        },
        "matching_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/plain_text"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "ordering": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plain_text"
          }
        },
        "partial_credit_rule": {
          "type": "string",
          "pattern": "^(?![\\s\\S]*<\\s*[A-Za-z!/?])[\\s\\S]*$"
        },
        "matrix": {
          "$ref": "#/$defs/matrix"
        },
        "cloze": {
          "$ref": "#/$defs/cloze"
        }
      }
    },
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stem"
      ],
      "properties": {
        "stem": {
          "$ref": "#/$defs/rich_text"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rich_text"
          }
        },
        "content_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_block"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media"
          }
        },
        "interaction": {
          "$ref": "#/$defs/interaction"
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_key",
        "status"
      ],
      "properties": {
        "answer_key": {},
        "status": {
          "enum": [
            "owner_key",
            "researched_official",
            "researched_unverified",
            "answer_not_found"
          ]
        },
        "source": {
          "$ref": "#/$defs/plain_text"
        },
        "evidence": {
          "$ref": "#/$defs/plain_text"
        },
        "explanation": {
          "$ref": "#/$defs/rich_text"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s<>]+$"
          }
        },
        "scoring_excluded": {
          "type": "boolean"
        },
        "reviewer_needed": {
          "type": "boolean"
        }
      }
    },
    "simulator_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mode": {
          "enum": [
            "practice",
            "exam"
          ]
        },
        "reveal_rules": {
          "$ref": "#/$defs/plain_text"
        },
        "review": {
          "type": "boolean"
        },
        "flagging": {
          "type": "boolean"
        },
        "counts_toward_trial": {
          "type": "boolean"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_key",
        "version",
        "type",
        "domain",
        "learner",
        "answer"
      ],
      "properties": {
        "question_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "domain": {
          "$ref": "#/$defs/plain_text"
        },
        "difficulty": {
          "$ref": "#/$defs/plain_text"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plain_text"
          }
        },
        "time_per_question": {
          "type": "integer",
          "minimum": 1
        },
        "learner": {
          "$ref": "#/$defs/learner"
        },
        "answer": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "certification",
        "exam_code",
        "name"
      ],
      "properties": {
        "vendor": {
          "$ref": "#/$defs/plain_text"
        },
        "certification": {
          "$ref": "#/$defs/plain_text"
        },
        "exam_code": {
          "$ref": "#/$defs/plain_text"
        },
        "name": {
          "$ref": "#/$defs/plain_text"
        },
        "version": {
          "$ref": "#/$defs/plain_text"
        },
        "duration": {
          "type": "integer",
          "minimum": 1
        },
        "passing_score": {
          "type": "number",
          "minimum": 0
        },
        "question_count": {
          "type": "integer",
          "minimum": 1
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "weight"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/plain_text"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "last_vendor_update": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "simulator_settings": {
          "$ref": "#/$defs/simulator_settings"
        }
      }
    },
    "hotspot_region": {
      "description": "Owner t547u: each region has a unique id, a label, a shape and coordinates normalised 0 to 1 relative to the image (rect: x, y, width, height; circle: cx, cy, r; polygon: x1, y1, x2, y2, ... at least 3 points).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "shape",
        "coords"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "label": {
          "$ref": "#/$defs/plain_text"
        },
        "shape": {
          "enum": [
            "rect",
            "circle",
            "polygon"
          ]
        },
        "coords": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 64
        }
      }
    },
    "matrix": {
      "description": "Owner t547u: matrix rows and columns, each with a unique id.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "columns"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "text": {
                "$ref": "#/$defs/rich_text"
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "text": {
                "$ref": "#/$defs/plain_text"
              }
            }
          }
        }
      }
    },
    "cloze": {
      "description": "t548u proposal (owner can change): fill-in-the-blank text. segments mix plain text and blank references; every blank has its own unique id and is referenced exactly once.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "blanks"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "$ref": "#/$defs/plain_text"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "blank"
                ],
                "properties": {
                  "blank": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  }
                }
              }
            ]
          }
        },
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "label": {
                "$ref": "#/$defs/plain_text"
              },
              "kind": {
                "enum": [
                  "dropdown",
                  "text"
                ]
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,64}$"
                    },
                    "text": {
                      "$ref": "#/$defs/plain_text"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "exact_key": {
      "description": "t557u: optional object form of answer_key for numeric and short_text. numeric: value (number text such as 0.5, 1/2, 5e-1), tolerance and tolerance_type (absolute or relative), range [min, max], sig_figs, unit and unit_conversions {unit: factor to the key unit}. short_text: accepted (list) and match (text, expression or number).",
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "tolerance": {
          "type": [
            "string",
            "number"
          ]
        },
        "tolerance_type": {
          "enum": [
            "absolute",
            "relative"
          ]
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "sig_figs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "unit_conversions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "match": {
          "enum": [
            "text",
            "expression",
            "number"
          ]
        }
      }
    }
  }
}
