# Copy to .env and fill in if you need them. Never put real values in this file.
# The pipeline reads the named variables below; a dotenv file is not loaded
# automatically, so export them in your shell or set them in the environment.

# Workspace that holds catalog.csv, research/, sources/, out/, and run.log
CERTPASSLY_ROOT=

# This skill checkout (SKILL.md, reference/, config/, shared/).
# Needed after a non-editable `pip install .` so stages can find site-format.
# Not needed for `pip install -e .`, a git clone, or `--help`.
CERTPASSLY_SKILL_ROOT=

# Frozen last-updated date (YYYY-MM-DD). Optional.
CERTPASSLY_DATE=

# Set to 1 to skip network (use saved official sources and the link-check cache).
CERTPASSLY_OFFLINE=

# Path to pipeline.yaml if it is not <workspace>/config/pipeline.yaml
CERTPASSLY_CONFIG=

# Path to the owner exam sheet (CSV) for the catalog stage
CERTPASSLY_SHEET=

# Optional path to a gold workspace for the full AB-730 regression
# (cached official pages, extracts, and the approved package). Not committed.
CERTPASSLY_GOLD=

# Site-format snapshot version (default v1)
CERTPASSLY_SITE_FORMAT=v1

# If you use a Drive API client of your own, put its key here. The bundled
# scripts do not ship a key and will not work without your own credentials.
# GOOGLE_DRIVE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
