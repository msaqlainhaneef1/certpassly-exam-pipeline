{
  "engine": "tesseract",
  "lang": "eng",
  "psm": 3,
  "scale": 2,
  "dpi": 200,
  "min_word_confidence": 50,
  "min_item_confidence": 40,
  "hold_below_confidence": 40,
  "tesseract_timeout_seconds": 60,
  "extract_tools": ["pdftohtml", "pdftoppm", "pdfimages"],
  "rasterize_pages_when_no_images": true,
  "install": {
    "apt_packages": ["tesseract-ocr", "tesseract-ocr-eng"],
    "pip_packages": []
  },
  "marker": {
    "dark": 70,
    "min_width_px": 14,
    "min_height_px": 12
  },
  "highlight": {
    "enabled": true,
    "min_area_px": 80,
    "max_area_ratio": 0.25,
    "hsv_ranges": [
      {"name": "yellow", "h_min": 20, "h_max": 40, "s_min": 80, "s_max": 255, "v_min": 140, "v_max": 255},
      {"name": "green", "h_min": 40, "h_max": 85, "s_min": 60, "s_max": 255, "v_min": 80, "v_max": 255},
      {"name": "cyan", "h_min": 85, "h_max": 110, "s_min": 60, "s_max": 255, "v_min": 80, "v_max": 255}
    ]
  },
  "checkbox": {
    "enabled": true,
    "min_side_px": 8,
    "max_side_px": 40,
    "fill_min": 0.15,
    "fill_max": 0.85,
    "border_dark": 140
  }
}
